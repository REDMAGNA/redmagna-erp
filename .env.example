POSTGRES_DB=redmagna
POSTGRES_USER=redmagna
# Reemplázalo por un secreto aleatorio de al menos 24 caracteres antes del primer arranque.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DATA_PATH=./data/postgres
BACKUP_PATH=./backups
MEDIA_PATH=./data/media
# GID del grupo DSM dedicado al ERP, para permisos de medios y respaldos enlazados.
ERP_DATA_GID=65534
RESTORE_DATABASE=redmagna_restore_test
# Al restaurar, define RESTORE_FILE con el nombre de un .dump en BACKUP_PATH.
RESTORE_FILE=
# Reemplázalo por otro secreto aleatorio, distinto y de al menos 50 caracteres.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ERP_API_TOKEN_TTL_HOURS=12
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For a DSM HTTPS reverse proxy, use its public hostname here and follow the proxy section in the NAS guide.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_HTTPS_PROXY=false
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
# Host address where Compose publishes the NAS port: use 127.0.0.1 for DSM reverse proxy only, or the NAS LAN IP for direct LAN access. Gunicorn listens on 0.0.0.0 inside the container.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000
# Valor prudente para el DS720+ con 2 GB de RAM; se puede subir tras ampliar memoria y medir uso.
APP_WORKERS=1
# SMTP envía RFQ, enlaces de soporte y avisos internos. También se usa para recordatorios CRM.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=
# Buzón IMAP opcional para recibir respuestas a tickets; requiere authserv-id del proveedor de correo.
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_USERNAME=
SUPPORT_IMAP_PASSWORD=
SUPPORT_IMAP_MAILBOX=INBOX
SUPPORT_IMAP_AUTH_SERV_ID=
# Activa el servicio Compose de recordatorios del CRM después de configurar SMTP.
CRM_REMINDERS_ENABLED=false
# Recordatorios externos de CxC: próximos a vencer y vencidos. Requiere validar correo/contactos antes de activar.
BILLING_REMINDERS_ENABLED=false
BILLING_REMINDER_DAYS_AHEAD=3
# Optional internal inbox for new web quote requests; blank keeps notifications off.
CRM_LEAD_NOTIFICATION_EMAIL=
# Address reachable by quote recipients; use HTTPS for remote customers.
ERP_PUBLIC_URL=http://localhost:8000/
# Solicitud pública de cotización; activa solo tras configurar HTTPS y aviso de privacidad.
ERP_PUBLIC_LEADS_ENABLED=false
ERP_PRIVACY_URL=
# Optional letterhead; blank legal name/RFC/email inherit CFDI_ISSUER_* and EMAIL_FROM.
ERP_COMPANY_NAME=Redmagna
ERP_COMPANY_LEGAL_NAME=
ERP_COMPANY_RFC=
ERP_COMPANY_ADDRESS=
ERP_COMPANY_PHONE=
ERP_COMPANY_EMAIL=
ERP_COMPANY_WEBSITE=
FEL_ENVIRONMENT=test
FEL_TIMBRADO_USER=
FEL_TIMBRADO_PASSWORD=
FEL_ALLOW_PRODUCTION=false
# La cancelación contacta al SAT, no tiene sandbox y requiere confirmación en pantalla.
FEL_ALLOW_CANCELLATION=false
FEL_CANCEL_PFX_BASE64=
FEL_CANCEL_PFX_PASSWORD=
CFDI_ISSUER_RFC=
CFDI_ISSUER_NAME=
CFDI_ISSUER_FISCAL_REGIME=
CFDI_ISSUER_POSTAL_CODE=
# El 8% requiere estímulo fronterizo vigente, emisor y conceptos elegibles; default seguro.
CFDI_ALLOW_BORDER_8_RATE=false
# Solo códigos postales de expedición revisados con el catálogo SAT de región fronteriza.
CFDI_BORDER_8_REVIEWED_POSTAL_CODES=
CFDI_PROVIDER_CODE=fel-premium
# Carpeta fuera del código con redmagna.cer, redmagna.key y csd_password.
CFDI_CSD_HOST_PATH=./secrets/fiscal
